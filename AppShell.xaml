<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HesapMakinesi.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HesapMakinesi"
    Title="Hesap Makinesi">

    <FlyoutItem Title="Standart Hesap Makinesi">
        <ShellContent
            Title="Standart"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Bilimsel Hesap Makinesi">
        <ShellContent
            Title="Bilimsel"
            ContentTemplate="{DataTemplate local:ScientificPage}"
            Route="ScientificPage" />
    </FlyoutItem>
    <FlyoutItem Title="Ayarlar">
        <ShellContent
            Title="Ayarlar"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="SettingsPage" />
    </FlyoutItem>
</Shell>
